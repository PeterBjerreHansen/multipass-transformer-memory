__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/
checkpoints/
artifacts/
*.pt
*.pth
*.safetensors
.DS_Store

# Materialized datasets are local artifacts; keep only the source recipes.
data/*
!data/README.md
!data/dolmino/
data/dolmino/*
!data/dolmino/wiring_2048/
data/dolmino/wiring_2048/*
!data/dolmino/wiring_2048/config.yaml
!data/dolmino/pilot_2048/
data/dolmino/pilot_2048/*
!data/dolmino/pilot_2048/config.yaml
!data/dolmino/gpu_2048/
data/dolmino/gpu_2048/*
!data/dolmino/gpu_2048/config.yaml
!data/dolmino/gpu_2048_staged/
data/dolmino/gpu_2048_staged/*
!data/dolmino/gpu_2048_staged/config.yaml
!data/dolmino/gpu_2048_long_2p5b/
data/dolmino/gpu_2048_long_2p5b/*
!data/dolmino/gpu_2048_long_2p5b/config.yaml
!data/dolmino/stage_6_evaluation_2048/
data/dolmino/stage_6_evaluation_2048/*
!data/dolmino/stage_6_evaluation_2048/config.yaml

# Training outputs remain colocated with their study/control but are not source.
# Keep the results README files visible, while ignoring every run directory or
# result file directly below the owning results directory.
benchmarks/**/results/*
!benchmarks/**/results/README.md

# Small reference timing reports, not checkpoints or raw training runs.
!benchmarks/development/inference_efficiency/results/inference_efficiency_verda_a6000.json
!benchmarks/development/inference_efficiency/results/inference_efficiency_verda_a6000_bf16.json

# Historical protocols and small summaries are source. Raw run payloads remain
# ignored by the general results rule above, regardless of study role.
benchmarks/ad_hoc/*

.coverage
