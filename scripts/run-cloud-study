#!/usr/bin/env python3
"""Run selected arms of a locked study sequentially and archive each one.

The study runner is restartable: a locally complete arm is skipped, while an
incomplete arm is handed to start-and-watch for remote resume/transfer.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass
import fcntl
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys

import yaml

from tiny_mistral_mptt.config import load_experiment_config
from tiny_mistral_mptt.studies import StudyValidationError, verify_study
from tiny_mistral_mptt.training.checkpoint import inspect_checkpoint


DEFAULT_REMOTE_ROOT = "/root/multipass-transformer-memory"
DEFAULT_LOCK = "/tmp/tinymistral-cloud-study.lock"
TRANSFER_MANIFEST = ".transfer-manifest.sha256"


@dataclass(frozen=True, slots=True)
class CloudStudyArm:
    config: str
    data_manifest_sha256: str


def _repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def _run(command: list[str], *, check: bool = True) -> int:
    print("$ " + " ".join(_quote(item) for item in command), flush=True)
    result = subprocess.run(command, cwd=_repo_root(), check=False)
    if check and result.returncode != 0:
        raise RuntimeError(f"command failed with exit code {result.returncode}")
    return result.returncode


def _quote(value: str) -> str:
    if value and all(character.isalnum() or character in "-._/:" for character in value):
        return value
    return repr(value)


def _local_manifest(root: Path) -> str:
    rows: list[str] = []
    for path in sorted(item for item in root.rglob("*") if item.is_file()):
        relative = path.relative_to(root).as_posix()
        if (
            relative == TRANSFER_MANIFEST
            or relative == ".rsync-partial"
            or relative.startswith(".rsync-partial/")
        ):
            continue
        digest = hashlib.sha256()
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        rows.append(f"{digest.hexdigest()}  {relative}")
    return "\n".join(rows)


def _local_complete(path: Path, *, expected_output: str | None = None) -> bool:
    required = (
        path / "run.json",
        path / "segments.jsonl",
        path / "checkpoints/latest.json",
        path / TRANSFER_MANIFEST,
    )
    if not all(item.is_file() for item in required):
        return False
    try:
        run_info = json.loads((path / "run.json").read_text(encoding="utf-8"))
        if expected_output is not None:
            recorded_output = run_info.get("config", {}).get("output_dir")
            if not isinstance(recorded_output, str):
                return False
            if Path(recorded_output).as_posix().rstrip("/") != Path(expected_output).as_posix().rstrip("/"):
                return False
        if (path / TRANSFER_MANIFEST).read_text(encoding="utf-8") != _local_manifest(path):
            return False
        pointer = json.loads(
            (path / "checkpoints/latest.json").read_text(encoding="utf-8")
        )
        current = pointer.get("current")
        if not isinstance(current, str) or Path(current).name != current:
            return False
        checkpoint = path / "checkpoints" / current
        if not checkpoint.is_file():
            return False
        inspect_checkpoint(checkpoint)
    except Exception:
        return False
    last_end = None
    try:
        for line in (path / "segments.jsonl").read_text(encoding="utf-8").splitlines():
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if record.get("event") == "segment_end":
                last_end = record
    except OSError:
        return False
    return bool(last_end and last_end.get("reason") == "completed")


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Run selected arms of a locked study one at a time and archive them locally."
    )
    parser.add_argument("--host", required=True, help="Verda VM hostname or IP")
    parser.add_argument("--vm-id", required=True, help="Verda VM ID")
    parser.add_argument("--remote-root", default=DEFAULT_REMOTE_ROOT)
    parser.add_argument("--study-dir", required=True)
    parser.add_argument(
        "--local-root",
        type=Path,
        help="local results root (default: <study-dir>/results)",
    )
    parser.add_argument(
        "--arm",
        dest="arms",
        action="append",
        help="run only this manifest arm; repeat for a subset (default: every arm)",
    )
    parser.add_argument("--ssh-key", type=Path, default=Path("~/.ssh/id_ed25519").expanduser())
    parser.add_argument("--verda", default="verda")
    parser.add_argument("--poll-seconds", type=float, default=60.0)
    parser.add_argument("--lock-file", type=Path, default=Path(DEFAULT_LOCK))
    parser.add_argument("--keep-vm", action="store_true", help="do not delete the VM after all arms")
    parser.add_argument("--no-notify", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    return parser


def _study_plan(study_dir: str) -> dict[str, CloudStudyArm]:
    relative = Path(study_dir)
    if relative.is_absolute():
        raise SystemExit("--study-dir must be relative to the repository root")
    study_path = (_repo_root() / relative).resolve()
    try:
        study_path.relative_to(_repo_root())
    except ValueError as exc:
        raise SystemExit("--study-dir must stay inside the repository") from exc
    manifest_path = study_path / "STUDY.yaml"
    try:
        verification = verify_study(manifest_path)
    except StudyValidationError as exc:
        raise SystemExit(f"study validation failed: {exc}") from exc
    if verification.status != "locked":
        raise SystemExit(f"cloud study must be locked before execution: {manifest_path}")
    if verification.learning_rates_qualified is False:
        raise SystemExit(
            "cloud study is blocked until learning-rate qualification is complete"
        )
    pinned_data = dict(verification.data_artifacts)
    if not pinned_data:
        raise SystemExit("cloud study must pin its data manifest hash before execution")
    raw = yaml.safe_load(manifest_path.read_text(encoding="utf-8")) or {}
    plan: dict[str, CloudStudyArm] = {}
    for arm in raw["arms"]:
        config_name = str(arm["config"])
        # Use the canonical loader so cloud execution supports the same
        # ``extends`` inheritance as local training and study verification.
        config = load_experiment_config(study_path / config_name)
        data_dir = Path(str(config.data_dir)).as_posix()
        expected_sha256 = pinned_data.get(data_dir)
        if expected_sha256 is None:
            raise SystemExit(
                f"cloud study does not pin the data manifest used by {config_name}: {data_dir}"
            )
        plan[str(arm["id"])] = CloudStudyArm(config_name, expected_sha256)
    return plan


def _study_arms(study_dir: str) -> dict[str, str]:
    """Return the config names after applying all cloud execution gates."""
    return {arm_id: arm.config for arm_id, arm in _study_plan(study_dir).items()}


def _controller_command(
    args: argparse.Namespace,
    arm: str,
    config_name: str,
    expected_data_manifest_sha256: str | None = None,
) -> list[str]:
    config = f"{args.study_dir}/{config_name}"
    remote_output = f"{args.study_dir}/results/{arm}"
    local_output = (args.local_root / arm).resolve()
    command = [
        str(_repo_root() / "scripts" / "start-and-watch"),
        "--host",
        args.host,
        "--vm-id",
        args.vm_id,
        "--remote-root",
        args.remote_root,
        "--config",
        config,
        "--remote-output",
        remote_output,
        "--local-output",
        str(local_output),
        "--ssh-key",
        str(args.ssh_key),
        "--verda",
        args.verda,
        "--start-vm",
        "--watch-existing",
        "--cleanup",
        "shutdown",
        "--transfer",
        "all",
        "--delete-remote-output",
        "--poll-seconds",
        str(args.poll_seconds),
    ]
    if expected_data_manifest_sha256 is not None:
        command.extend(
            ["--expected-data-manifest-sha256", expected_data_manifest_sha256]
        )
    if args.no_notify:
        command.append("--no-notify")
    return command


def _delete_vm(args: argparse.Namespace) -> None:
    # The persistent OS volume is deliberately retained by omitting
    # --with-volumes; only the compute instance is deleted.
    _run(
        [
            args.verda,
            "--agent",
            "vm",
            "delete",
            "--id",
            args.vm_id,
            "--wait",
            "--yes",
        ]
    )


def _best_effort_shutdown(args: argparse.Namespace) -> None:
    print("WARN: attempting best-effort VM shutdown after study failure", flush=True)
    _run(
        [
            args.verda,
            "--agent",
            "vm",
            "shutdown",
            "--id",
            args.vm_id,
            "--wait",
            "--yes",
        ],
        check=False,
    )


def main() -> int:
    args = _parser().parse_args()
    study_plan = _study_plan(args.study_dir)
    if args.local_root is None:
        args.local_root = Path(args.study_dir) / "results"
    args.local_root = args.local_root.expanduser().resolve()
    args.ssh_key = args.ssh_key.expanduser()
    arms = tuple(args.arms or study_plan)
    unknown_arms = sorted(set(arms) - set(study_plan))
    if unknown_arms:
        raise SystemExit(f"unknown study arms: {', '.join(unknown_arms)}")
    if args.poll_seconds <= 0:
        raise SystemExit("--poll-seconds must be positive")
    if not args.dry_run and not args.ssh_key.is_file():
        raise SystemExit(f"SSH key does not exist: {args.ssh_key}")

    print(f"INFO: study arms: {', '.join(arms)}")
    print(f"INFO: local root: {args.local_root}")
    print(f"INFO: final VM action: {'keep' if args.keep_vm else 'delete compute instance'}")
    if args.dry_run:
        for arm in arms:
            planned = study_plan[arm]
            command = _controller_command(
                args,
                arm,
                planned.config,
                planned.data_manifest_sha256,
            )
            print("DRY-RUN: " + " ".join(_quote(item) for item in command))
        return 0

    args.lock_file.parent.mkdir(parents=True, exist_ok=True)
    with args.lock_file.open("w", encoding="utf-8") as lock_handle:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SystemExit(f"another cloud study is already running: {args.lock_file}") from exc

        try:
            args.local_root.mkdir(parents=True, exist_ok=True)
            for index, arm in enumerate(arms, start=1):
                local_output = args.local_root / arm
                remote_output = f"{args.study_dir}/results/{arm}"
                print(f"\n=== ARM {index}/{len(arms)}: {arm} ===", flush=True)
                if _local_complete(local_output, expected_output=remote_output):
                    print(f"SKIP: local artifacts are already complete: {local_output}", flush=True)
                    continue
                print(f"RUN: transferring full artifacts to {local_output}", flush=True)
                planned = study_plan[arm]
                _run(
                    _controller_command(
                        args,
                        arm,
                        planned.config,
                        planned.data_manifest_sha256,
                    )
                )
                if not _local_complete(local_output, expected_output=remote_output):
                    raise RuntimeError(f"controller returned success but local arm is incomplete: {local_output}")
                print(f"PASS: local artifacts complete: {local_output}", flush=True)

            if args.keep_vm:
                print("PASS: study complete; VM retained by request", flush=True)
            else:
                print("INFO: all selected arms complete; deleting compute instance", flush=True)
                _delete_vm(args)
                print("PASS: study complete; compute instance deleted", flush=True)
            return 0
        except KeyboardInterrupt:
            _best_effort_shutdown(args)
            print("ERROR: study interrupted; VM was shut down, artifacts were retained", file=sys.stderr)
            return 130
        except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
            _best_effort_shutdown(args)
            print(f"ERROR: study stopped: {exc}", file=sys.stderr)
            return 2


if __name__ == "__main__":
    raise SystemExit(main())
